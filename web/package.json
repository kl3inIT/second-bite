    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
