{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm check:tokens && pnpm check:messages && pnpm check:api && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm knip",
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "check:tokens": "node scripts/generate-tokens.mjs --check",
    "check:messages": "node scripts/check-messages.mjs",
    "generate:api": "pnpm --filter openapi-codegen generate",
    "check:api": "node scripts/check-api.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "stub:backend": "node tests/e2e/stub-backend.mjs",
    "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@protomaps/basemaps": "5.7.2",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "jsqr": "1.4.0",
    "lucide-react": "^1.62.0",
    "maplibre-gl": "6.16.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "nuqs": "^2.10.2",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-map-gl": "8.1.3",
    "react-resizable-panels": "^4.15.0",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@maplibre/maplibre-gl-style-spec": "26.4.4",
    "@playwright/test": "1.64.1",
    "@shadcn/lint": "0.2.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "knip": "^6.43.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  }
}
