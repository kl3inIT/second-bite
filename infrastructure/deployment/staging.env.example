# /apps/secondbite-staging/.env.staging on the host: root-owned, mode 0600. It feeds Compose interpolation of
# compose.staging.yaml and holds no secret; secrets are files under /apps/secondbite-staging/secrets.
# deploy.sh supplies the image names. A setting that is not secret and differs by environment is added here when
# the server first reads one.

# Google's OAuth client IDs whose tokens are accepted, the web's first, comma-separated. Public, but owned by whoever
# owns the Google Cloud project, so never in Git (docs/runbooks/ci-cd.md). Empty leaves signing in with Google off.
SECONDBITE_GOOGLE_CLIENT_IDS=

# Web Push (SEC-25): the public key that `secondbite push keys` printed when it wrote secrets/push-private-key, and
# the site's origin, which the pushes open. Public; an empty key leaves Web Push off.
SECONDBITE_PUSH_PUBLIC_KEY=
SECONDBITE_SITE_URL=https://secondbite.vadan.app
