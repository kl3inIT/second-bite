[Unit]
Description=Back up the Second Bite databases
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# Production first: it is the one that must not be missed. Staging's dump is skipped while staging is not running.
ExecStart=/usr/local/sbin/secondbite-backup production
ExecStart=-/usr/local/sbin/secondbite-backup staging
